# ==========================================
# STEP 1: IMPORT LIBRARIES
# ==========================================

import pandas as pd
import re

from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.model_selection import train_test_split


# ==========================================
# STEP 2: LOAD CLEANED DATASET
# ==========================================

df = pd.read_csv("NLP_Cleaned_Data.csv")

print("Dataset Loaded Successfully!")
print("Dataset Shape:", df.shape)


# ==========================================
# STEP 3: REMOVE HTML TAGS
# ==========================================

def remove_html(text):
    text = str(text)
    text = re.sub(r'<.*?>', ' ', text)
    text = re.sub(r'\s+', ' ', text)
    return text.strip()


# ==========================================
# STEP 4: SELECT TEXT COLUMNS
# ==========================================

text_columns = [
    'title',
    'company_profile',
    'description',
    'requirements',
    'benefits'
]


# ==========================================
# STEP 5: COMBINE TEXT COLUMNS
# ==========================================

for col in text_columns:
    df[col] = df[col].fillna('').apply(remove_html)

df['combined_text'] = (
    df['title'] + ' ' +
    df['company_profile'] + ' ' +
    df['description'] + ' ' +
    df['requirements'] + ' ' +
    df['benefits']
)

print("\nCombined Text Created!")
print(df['combined_text'].head())


# ==========================================
# STEP 6: ENCODE TARGET COLUMN
# ==========================================

print("\nOriginal Target Values:")
print(df['fraudulent'].value_counts())

df['fraudulent'] = df['fraudulent'].map({
    'f': 0,
    't': 1
})

print("\nTarget Values After Encoding:")
print(df['fraudulent'].value_counts())


# ==========================================
# STEP 7: SPLIT DATA
# ==========================================

X = df['combined_text']
y = df['fraudulent']

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("\nTraining Data:", X_train.shape)
print("Testing Data:", X_test.shape)


# ==========================================
# STEP 8: APPLY TF-IDF
# ==========================================

tfidf = TfidfVectorizer(
    max_features=5000,
    ngram_range=(1, 2),
    min_df=2,
    max_df=0.95
)

X_train_tfidf = tfidf.fit_transform(X_train)

X_test_tfidf = tfidf.transform(X_test)


# ==========================================
# STEP 9: CHECK RESULTS
# ==========================================

print("\nTF-IDF Vectorization Completed!")

print("Training TF-IDF Shape:", X_train_tfidf.shape)

print("Testing TF-IDF Shape:", X_test_tfidf.shape)

print("\nSample Features:")
print(tfidf.get_feature_names_out()[:30])


# ==========================================
# STEP 10: SAVE TF-IDF FEATURES
# ==========================================

print("\nTotal Vocabulary Size:", len(tfidf.vocabulary_))

print("\nProject Step Completed Successfully!")



# ==========================================
# STEP 1: IMPORT LIBRARIES
# ==========================================

from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix
)

# ==========================================
# STEP 2: CREATE LOGISTIC REGRESSION MODEL
# ==========================================

lr_model = LogisticRegression(
    max_iter=1000,
    class_weight='balanced',
    random_state=42
)

print("Logistic Regression Model Created Successfully!")

# ==========================================
# STEP 3: TRAIN THE MODEL
# ==========================================

lr_model.fit(X_train_tfidf, y_train)

print("Model Training Completed Successfully!")

# ==========================================
# STEP 4: MAKE PREDICTIONS
# ==========================================

y_pred = lr_model.predict(X_test_tfidf)

print("Predictions Completed Successfully!")

# ==========================================
# STEP 5: CHECK MODEL ACCURACY
# ==========================================

accuracy = accuracy_score(y_test, y_pred)

print("\nModel Accuracy:", accuracy)
print("Accuracy Percentage:", accuracy * 100, "%")

# ==========================================
# STEP 6: CLASSIFICATION REPORT
# ==========================================

print("\nClassification Report:")
print(classification_report(
    y_test,
    y_pred,
    target_names=['Genuine Job', 'Fake Job'],
    zero_division=0
))

# ==========================================
# STEP 7: CONFUSION MATRIX
# ==========================================

cm = confusion_matrix(y_test, y_pred)

print("\nConfusion Matrix:")
print(cm)

# ==========================================
# STEP 8: FINAL RESULT
# ==========================================

print("\nLogistic Regression Model Completed Successfully!")





