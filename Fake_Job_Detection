import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score
)

# ==========================================
# STEP 1: CALCULATE LOGISTIC REGRESSION METRICS
# ==========================================

lr_metrics = {
    'Accuracy': accuracy_score(y_test, y_pred),
    'Precision': precision_score(y_test, y_pred, pos_label=1),
    'Recall': recall_score(y_test, y_pred, pos_label=1),
    'F1 Score': f1_score(y_test, y_pred, pos_label=1)
}

# ==========================================
# STEP 2: CALCULATE RANDOM FOREST METRICS
# ==========================================

rf_metrics = {
    'Accuracy': accuracy_score(y_test, rf_pred),
    'Precision': precision_score(y_test, rf_pred, pos_label=1),
    'Recall': recall_score(y_test, rf_pred, pos_label=1),
    'F1 Score': f1_score(y_test, rf_pred, pos_label=1)
}

# ==========================================
# STEP 3: CREATE COMPARISON DATAFRAME
# ==========================================

comparison_df = pd.DataFrame({
    'Logistic Regression': lr_metrics,
    'Random Forest': rf_metrics
})

print("\nFINAL MODEL COMPARISON")
print(comparison_df.round(3))

# ==========================================
# STEP 4: VISUALIZE COMPARISON
# ==========================================

comparison_df.plot(
    kind='bar',
    figsize=(10, 6),
    width=0.7
)

plt.title('Fake Job Detection - Model Comparison')
plt.xlabel('Evaluation Metrics')
plt.ylabel('Score')
plt.ylim(0, 1.1)

plt.xticks(rotation=0)
plt.legend(title='Machine Learning Models')

plt.grid(axis='y', linestyle='--', alpha=0.5)

plt.tight_layout()
plt.show()

print("\nModel Comparison Completed Successfully!")


